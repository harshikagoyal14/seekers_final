# Supabase — safe for browser (anon key has RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Never in NEXT_PUBLIC_. CI guard enforces this.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://seekers.community

# Contact & lead encryption (AES-GCM key, 32 bytes hex)
CONTACT_ENCRYPTION_KEY=

# Email (Resend)
EMAIL_API_KEY=
EMAIL_FROM=hello@seekers.community

# Scheduled jobs
CRON_SECRET=

# Session (legacy — remove after Supabase Auth fully replaces cookies)
SESSION_SECRET=
